{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 36,
    "margin-right": 0,
    "margin-left": 0,

    "modules-left": [
        "custom/os_button",
        "niri/workspaces"
    ],
    "modules-center": ["cffi/niri-windows"],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "disk",
        "tray",
        "pulseaudio",
        "network",
        "battery",
        "niri/language",
        "clock#date",
        "clock#time"
    ],
    "niri/language": {
        "format": "{}",
        "format-en": "ENG",
        "format-ru": "РУС"
    },
    "niri/workspaces": {
        "icon-size": 32,
        "spacing": 16
    },
    "custom/os_button": {
        "format": "",
        "on-click": "walker",
        "tooltip": false
    },
    "cpu": {
        "interval": 5,
        "format": "  {usage}%",
        "max-length": 10
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp2_input",
        "critical-threshold": 75,
        "tooltip": false,
        "format-critical": "({temperatureC}°C)",
        "format": "({temperatureC}°C)"
    },
    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "unit": "GB",
        "tooltip-format":  "Available {free} of {total}"
    },
    "memory": {
        "interval": 10,
        "format": "  {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "RAM - {used:0.1f}GiB used"
    },
    "cffi/niri-windows": {
        "module_path": "/home/papelito/.config/waybar/waybar-niri-windows.so",
        "options": {
            "mode": "graphical",
            "icon-minimum-size": 1,
            "rules": [
                { "app-id": "firefox", "icon": "󰈹" },
                { "app-id": "kitty", "icon": "\uf489" },
                { "app-id": "nautilus", "icon": "󰉋" },
                { "app-id": "telegram", "icon": "\ue217" },
                { "app-id": "slack", "icon": "󰒱" },
                { "app-id": ".*", "icon": "󰣆" }
            ]
        }
    },
    "tray": {
        "icon-size": 18,
        "spacing": 3
    },
    "clock#date": {
        "timezone": "America/Argentina/Buenos_Aires",
        "format": "{:%d-%m-%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 60
    },
    "clock#time": {
        "timezone": "America/Argentina/Buenos_Aires",
        "format": "{:%H:%M:%S}",
        "interval": 1
    },
    "network": {
        "format-wifi": " {icon}",
        "format-ethernet": "  ",
        "format-disconnected": "󰌙",
        "format-icons": [
            "󰤯 ",
            "󰤟 ",
            "󰤢 ",
            "󰤢 ",
            "󰤨 "
        ]
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "pulseaudio": {
        "max-volume": 150,
        "scroll-step": 10,
        "format": "{icon}",
        "tooltip-format": "{volume}%",
        "format-muted": " ",
        "format-icons": {
            "default": [
                " ",
                " ",
                " "
            ]
        },
        "on-click": "pwvucontrol"
    }
}
