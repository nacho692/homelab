#!/usr/bin/env bash
set -uo pipefail

METRICS_BASE="{{ monitoring_metrics_path }}"
GRAPHS_DIR="{{ monitoring_graphs_path }}"
OUTPUT="${GRAPHS_DIR}/index.html"

GRAPH_WIDTH=600
GRAPH_HEIGHT=200

COLORS=("#4285f4" "#ea4335" "#34a853" "#fbbc05" "#ff6d01")

mkdir -p "$GRAPHS_DIR"

# --- Generate graphs ---
declare -a SECTIONS=()

for host_dir in "${METRICS_BASE}"/*/; do
    [ -d "$host_dir" ] || continue
    hostname=$(basename "$host_dir")

    host_rrd="${host_dir}/host.rrd"
    if [ -f "$host_rrd" ]; then
        # CPU
        rrdtool graph "${GRAPHS_DIR}/${hostname}-cpu.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — CPU %" --start -1d \
            -l 0 -u 100 --rigid -v "%" \
            "DEF:cpu=${host_rrd}:cpu:AVERAGE" \
            "AREA:cpu#4285f480" "LINE1:cpu#4285f4:CPU" >/dev/null 2>&1
        SECTIONS+=("${hostname}|Host|CPU %|${hostname}-cpu.svg")

        # RAM
        rrdtool graph "${GRAPHS_DIR}/${hostname}-ram.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — RAM %" --start -1d \
            -l 0 -u 100 --rigid -v "%" \
            "DEF:ram=${host_rrd}:ram:AVERAGE" \
            "AREA:ram#ea433580" "LINE1:ram#ea4335:RAM" >/dev/null 2>&1
        SECTIONS+=("${hostname}|Host|RAM %|${hostname}-ram.svg")

        # Load
        rrdtool graph "${GRAPHS_DIR}/${hostname}-load.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — Load Average" --start -1d \
            -v "load" \
            "DEF:l1=${host_rrd}:load1:AVERAGE" \
            "DEF:l5=${host_rrd}:load5:AVERAGE" \
            "DEF:l15=${host_rrd}:load15:AVERAGE" \
            "LINE2:l1#4285f4:1 min" \
            "LINE2:l5#fbbc05:5 min" \
            "LINE2:l15#ea4335:15 min" >/dev/null 2>&1
        SECTIONS+=("${hostname}|Host|Load Average|${hostname}-load.svg")

        # Disk
        rrdtool graph "${GRAPHS_DIR}/${hostname}-disk.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — Root Disk %" --start -1d \
            -l 0 -u 100 --rigid -v "%" \
            "DEF:disk=${host_rrd}:disk:AVERAGE" \
            "AREA:disk#34a85380" "LINE1:disk#34a853:Disk" >/dev/null 2>&1
        SECTIONS+=("${hostname}|Host|Root Disk %|${hostname}-disk.svg")

        # Temperature
        rrdtool graph "${GRAPHS_DIR}/${hostname}-temp.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — Temperature" --start -1d \
            -v "°C" \
            "DEF:temp=${host_rrd}:temp:AVERAGE" \
            "LINE2:temp#ea4335:Temp" >/dev/null 2>&1
        SECTIONS+=("${hostname}|Host|Temperature|${hostname}-temp.svg")
    fi

    # Smartctl graphs
    smartctl_rrd="${host_dir}/smartctl.rrd"
    if [ -f "$smartctl_rrd" ]; then
{% for device in scrutiny_devices | default([]) %}
{% set dev_short = device | regex_replace('/dev/', '') %}
        rrdtool graph "${GRAPHS_DIR}/${hostname}-smart-{{ dev_short }}.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — {{ device }} Temperature" --start -7d \
            -v "°C" \
            "DEF:temp=${smartctl_rrd}:temp_{{ dev_short }}:AVERAGE" \
            "LINE2:temp#ea4335:Temp" >/dev/null 2>&1
        SECTIONS+=("${hostname}|SMART|{{ device }} Temp|${hostname}-smart-{{ dev_short }}.svg")
{% endfor %}
    fi

    # Per-service RRD graphs from dashboard.yml fragments
{% for svc in dashboard_service_configs | default([]) %}
    service_rrd="${host_dir}/{{ svc.service }}.rrd"
    if [ -f "$service_rrd" ]; then
{% for graph in svc.graphs %}
{% set safe_name = graph.title | lower | regex_replace('[^a-z0-9]+', '-') | regex_replace('^-|-$', '') %}
        rrdtool graph "${GRAPHS_DIR}/${hostname}-{{ svc.service }}-{{ safe_name }}.svg" \
            --imgformat SVG -w $GRAPH_WIDTH -h $GRAPH_HEIGHT \
            --title "${hostname} — {{ svc.title }} — {{ graph.title }}" --start -1d \
            -v "{{ graph.units }}" \
{% for ds in graph.ds %}
            "DEF:{{ ds }}=${service_rrd}:{{ ds }}:AVERAGE" \
{% endfor %}
{% for ds in graph.ds %}
            "{{ 'AREA' if loop.first and graph.ds | length == 1 else 'LINE2' }}:{{ ds }}{{ (['#4285f480', '#ea433580', '#34a85380', '#fbbc0580', '#ff6d0180'][loop.index0 % 5]) if loop.first and graph.ds | length == 1 else (['#4285f4', '#ea4335', '#34a853', '#fbbc05', '#ff6d01'][loop.index0 % 5]) }}:{{ ds }}"{{ " \\" if not loop.last else "" }}
{% endfor %}
            >/dev/null 2>&1
        SECTIONS+=("${hostname}|{{ svc.title }}|{{ graph.title }}|${hostname}-{{ svc.service }}-{{ safe_name }}.svg")
{% endfor %}
    fi
{% endfor %}
done

# --- Generate HTML ---
cat > "$OUTPUT" << 'HTMLEOF'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Homelab Dashboard</title>
<meta http-equiv="refresh" content="300">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 0; padding: 20px; background: #0f1117; color: #e0e0e0; }
  h1 { color: #4285f4; margin-bottom: 4px; }
  h2 { color: #fbbc05; border-bottom: 1px solid #333; padding-bottom: 8px; margin-top: 32px; }
  h3 { color: #34a853; margin-bottom: 8px; }
  .timestamp { color: #888; font-size: 0.85em; margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(640px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .card { background: #1a1d29; border-radius: 8px; padding: 12px; }
  .card img { width: 100%; display: block; }
</style>
</head>
<body>
<h1>Homelab Monitoring</h1>
HTMLEOF

echo "<p class='timestamp'>Generated: $(date '+%Y-%m-%d %H:%M:%S')</p>" >> "$OUTPUT"

current_host=""
current_section=""
for entry in "${SECTIONS[@]}"; do
    IFS='|' read -r host section title file <<< "$entry"
    if [ "$host" != "$current_host" ]; then
        [ -n "$current_section" ] && echo "</div>" >> "$OUTPUT"
        echo "<h2>${host}</h2>" >> "$OUTPUT"
        current_host="$host"
        current_section=""
    fi
    if [ "$section" != "$current_section" ]; then
        [ -n "$current_section" ] && echo "</div>" >> "$OUTPUT"
        echo "<h3>${section}</h3><div class='grid'>" >> "$OUTPUT"
        current_section="$section"
    fi
    echo "<div class='card'><img src='${file}' alt='${title}'></div>" >> "$OUTPUT"
done
[ -n "$current_section" ] && echo "</div>" >> "$OUTPUT"

echo "</body></html>" >> "$OUTPUT"
