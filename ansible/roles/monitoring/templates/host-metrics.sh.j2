#!/usr/bin/env bash
set -euo pipefail

source "{{ monitoring_base_path }}/influx-write-helper.sh"

# CPU usage (percentage, from /proc/stat delta over 1 second)
read -r cpu_user cpu_nice cpu_sys cpu_idle cpu_iowait _ < <(
    awk '/^cpu / {print $2, $3, $4, $5, $6}' /proc/stat
)
sleep 1
read -r cpu_user2 cpu_nice2 cpu_sys2 cpu_idle2 cpu_iowait2 _ < <(
    awk '/^cpu / {print $2, $3, $4, $5, $6}' /proc/stat
)
total_delta=$(( (cpu_user2+cpu_nice2+cpu_sys2+cpu_idle2+cpu_iowait2) - (cpu_user+cpu_nice+cpu_sys+cpu_idle+cpu_iowait) ))
idle_delta=$(( cpu_idle2 - cpu_idle ))
if [ "$total_delta" -gt 0 ]; then
    cpu_pct=$(awk "BEGIN {printf \"%.1f\", 100 * (1 - ${idle_delta}/${total_delta})}")
else
    cpu_pct="0.0"
fi

# RAM (percentage used)
read -r mem_total mem_avail < <(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{print t, a}' /proc/meminfo)
ram_pct=$(awk "BEGIN {printf \"%.1f\", 100 * (1 - ${mem_avail}/${mem_total})}")

# Load averages
read -r load1 load5 load15 _ < /proc/loadavg

# Temperature (thermal zone 0, or U if unavailable)
if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
    temp_raw=$(cat /sys/class/thermal/thermal_zone0/temp)
    temp=$(awk "BEGIN {printf \"%.1f\", ${temp_raw}/1000}")
else
    temp="U"
fi

write_influx "host,hostname={{ inventory_hostname }} cpu=${cpu_pct},ram=${ram_pct},load1=${load1},load5=${load5},load15=${load15},temp=${temp}"

# Disk usage (per-mount)
{% for disk in monitoring_disk_mounts | default([{'mount': '/', 'label': 'root'}]) %}
disk_pct_{{ loop.index }}=$(df {{ disk.mount }} 2>/dev/null | awk 'NR==2 {gsub(/%/,""); print $5}' || echo "U")
if [ "${disk_pct_{{ loop.index }}}" != "U" ]; then
    write_influx "disk_usage,hostname={{ inventory_hostname }},mount={{ disk.label }} pct=${disk_pct_{{ loop.index }}}"
fi
{% endfor %}

# Disk I/O stats (from /proc/diskstats)
while read -r _ _ dev reads _ sectors_read _ writes _ sectors_written _; do
    case "$dev" in
        sd[a-z]|nvme[0-9]*n[0-9]) ;;  # keep whole disks only
        *) continue ;;
    esac
    read_bytes=$(( sectors_read * 512 ))
    write_bytes=$(( sectors_written * 512 ))
    write_influx "disk_io,hostname={{ inventory_hostname }},device=${dev} read_bytes=${read_bytes}i,write_bytes=${write_bytes}i,read_ops=${reads}i,write_ops=${writes}i"
done < /proc/diskstats

# Network interface stats (host-level)
for iface_path in /sys/class/net/*/statistics; do
    iface=$(basename "$(dirname "$iface_path")")
    # Skip virtual interfaces
    case "$iface" in lo|veth*|br-*|docker*) continue ;; esac
    rx_bytes=$(< "$iface_path/rx_bytes")
    tx_bytes=$(< "$iface_path/tx_bytes")
    rx_packets=$(< "$iface_path/rx_packets")
    tx_packets=$(< "$iface_path/tx_packets")
    rx_errors=$(< "$iface_path/rx_errors")
    tx_errors=$(< "$iface_path/tx_errors")
    rx_dropped=$(< "$iface_path/rx_dropped")
    tx_dropped=$(< "$iface_path/tx_dropped")
    write_influx "net,hostname={{ inventory_hostname }},iface=${iface} rx_bytes=${rx_bytes}i,tx_bytes=${tx_bytes}i,rx_packets=${rx_packets}i,tx_packets=${tx_packets}i,rx_errors=${rx_errors}i,tx_errors=${tx_errors}i,rx_dropped=${rx_dropped}i,tx_dropped=${tx_dropped}i"
done

# Docker container network stats (if docker is available)
# Reads exact byte counters from each container's network namespace via /proc/<pid>/net/dev
if command -v docker &>/dev/null; then
    for cid in $(docker ps -q 2>/dev/null); do
        cname=$(docker inspect --format {% raw %}'{{.Name}}'{% endraw %} "$cid" 2>/dev/null | sed 's|^/||')
        netmode=$(docker inspect --format {% raw %}'{{.HostConfig.NetworkMode}}'{% endraw %} "$cid" 2>/dev/null)
        [ "$netmode" = "host" ] && continue
        cpid=$(docker inspect --format {% raw %}'{{.State.Pid}}'{% endraw %} "$cid" 2>/dev/null)
        [ -z "$cpid" ] || [ "$cpid" = "0" ] && continue
        read -r rx_bytes tx_bytes < <(
            awk '/:/ && !/lo:/ {rx+=$2; tx+=$10} END {printf "%.0f %.0f\n", rx, tx}' "/proc/${cpid}/net/dev" 2>/dev/null
        ) || continue
        [ -z "$rx_bytes" ] && continue
        write_influx "container_net,hostname={{ inventory_hostname }},container=${cname} rx_bytes=${rx_bytes}i,tx_bytes=${tx_bytes}i"
    done
fi
