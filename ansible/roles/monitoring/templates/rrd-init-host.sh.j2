#!/usr/bin/env bash
set -euo pipefail

RRD_FILE="{{ monitoring_metrics_path }}/{{ inventory_hostname }}/host.rrd"

if [ -f "$RRD_FILE" ]; then
    echo "EXISTS host.rrd"
    exit 0
fi

rrdtool create "$RRD_FILE" \
    --step {{ monitoring_rrd_step }} \
    DS:cpu:GAUGE:600:0:100 \
    DS:ram:GAUGE:600:0:100 \
    DS:disk:GAUGE:600:0:100 \
    DS:load1:GAUGE:600:0:U \
    DS:load5:GAUGE:600:0:U \
    DS:load15:GAUGE:600:0:U \
    DS:temp:GAUGE:600:U:U \
{% for rra in monitoring_rrd_rra %}
    {{ rra }}{{ " \\" if not loop.last else "" }}
{% endfor %}

echo "CREATED host.rrd"
