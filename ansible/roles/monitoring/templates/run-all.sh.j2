#!/usr/bin/env bash
set -uo pipefail

BASE="{{ monitoring_base_path }}"
SERVICES_BASE="{{ monitoring_base_path }}/services"
LOG_FILE="/var/log/monitoring.log"

log() { echo "$(date -Iseconds) $*" >> "$LOG_FILE"; }

# --- Host metrics ---
log "Collecting host metrics"
if [ -x "${BASE}/host/collect.sh" ]; then
    "${BASE}/host/collect.sh" >> "$LOG_FILE" 2>&1 || log "ERROR: host/collect.sh failed"
fi

# Custom host metrics (collect-*.sh)
for custom_script in "${BASE}/host/collect-"*.sh; do
    [ -x "$custom_script" ] || continue
    log "Running custom: $(basename "$custom_script")"
    "$custom_script" >> "$LOG_FILE" 2>&1 || log "ERROR: $(basename "$custom_script") failed"
done

# --- Per-service metrics ---
for service_dir in "${SERVICES_BASE}"/*/; do
    [ -d "$service_dir" ] || continue
    service_name=$(basename "$service_dir")

    if [ -x "${service_dir}/collect.sh" ]; then
        log "Collecting metrics for ${service_name}"
        "${service_dir}/collect.sh" >> "$LOG_FILE" 2>&1 || log "ERROR: ${service_name}/collect.sh failed"
    fi

    if [ -x "${service_dir}/check.sh" ]; then
        log "Running checks for ${service_name}"
        "${service_dir}/check.sh" >> "$LOG_FILE" 2>&1 || log "ERROR: ${service_name}/check.sh failed"
    fi
done

log "Collection complete"
