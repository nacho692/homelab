#!/usr/bin/env bash
set -euo pipefail

source "{{ monitoring_base_path }}/influx-write-helper.sh"
JELLYFIN_URL="http://localhost:{{ service_ports.jellyfin }}"

# Response latency
latency=$(curl -sf -o /dev/null -w "%{time_total}" "${JELLYFIN_URL}/health" 2>/dev/null || echo "U")
if [ "$latency" != "U" ]; then
    latency_ms=$(awk "BEGIN {printf \"%.0f\", ${latency} * 1000}")
else
    latency_ms="U"
fi

# Active sessions (requires API key)
sessions_json=$(curl -sf "${JELLYFIN_URL}/Sessions?api_key={{ vault_jellyfin_api_key }}" 2>/dev/null || echo "[]")
active_streams=$(echo "$sessions_json" | jq '[.[] | select(.NowPlayingItem != null)] | length' 2>/dev/null || echo "U")
transcoding_streams=$(echo "$sessions_json" | jq '[.[] | select(.TranscodingInfo != null)] | length' 2>/dev/null || echo "U")

write_influx "jellyfin,hostname={{ inventory_hostname }} latency_ms=${latency_ms},active_streams=${active_streams},transcoding_streams=${transcoding_streams}"
