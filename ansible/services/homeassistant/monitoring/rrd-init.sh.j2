#!/usr/bin/env bash
set -euo pipefail

RRD_FILE="{{ monitoring_metrics_path }}/{{ inventory_hostname }}/homeassistant.rrd"

if [ -f "$RRD_FILE" ]; then echo "EXISTS homeassistant.rrd"; exit 0; fi

rrdtool create "$RRD_FILE" \
    --step {{ monitoring_rrd_step }} \
    DS:latency_ms:GAUGE:600:0:U \
{% for rra in monitoring_rrd_rra %}
    {{ rra }}{{ " \\" if not loop.last else "" }}
{% endfor %}

echo "CREATED homeassistant.rrd"
