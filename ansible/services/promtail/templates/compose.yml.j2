services:
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    restart: unless-stopped
    # Run as root so we can read /var/run/docker.sock without per-host GID wrangling.
    # Socket access is already effectively host-root, so container user doesn't change posture.
    user: "0:0"
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./config:/etc/promtail
      - {{ paths.config }}:{{ paths.config }}:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    # Force loki.internal to resolve to the NAS host IP. Without this, Docker's
    # embedded DNS on the `internal` network returns caddy-docker-proxy's
    # container IP, which doesn't listen on 443 internally.
    extra_hosts:
      - "loki.{{ internal_domain }}:{{ nas_ip }}"
    networks:
      - internal

networks:
  internal:
    external: true
