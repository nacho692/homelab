services:
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    restart: unless-stopped
    # Run as root so we can read /var/run/docker.sock without per-host GID wrangling.
    # Socket access is already effectively host-root, so container user doesn't change posture.
    user: "0:0"
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./config:/etc/promtail
      - {{ paths.config }}:{{ paths.config }}:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - internal

networks:
  internal:
    external: true
