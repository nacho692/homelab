services:
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    restart: unless-stopped
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./config:/etc/promtail
      - {{ paths.config }}:{{ paths.config }}:ro
    networks:
      - internal

networks:
  internal:
    external: true
