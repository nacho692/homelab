services:
  influxdb:
    image: influxdb:2
    container_name: influxdb
    restart: unless-stopped
    ports:
      - "{{ service_ports.influxdb }}:8086"
    environment:
      - DOCKER_INFLUXDB_INIT_MODE=setup
      - DOCKER_INFLUXDB_INIT_USERNAME=admin
      - DOCKER_INFLUXDB_INIT_PASSWORD=${INFLUXDB_ADMIN_PASSWORD}
      - DOCKER_INFLUXDB_INIT_ORG=homelab
      - DOCKER_INFLUXDB_INIT_BUCKET=homelab
      - DOCKER_INFLUXDB_INIT_RETENTION=365d
      - DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUXDB_TOKEN}
    volumes:
      - {{ paths.config }}/monitoring/influxdb/data:/var/lib/influxdb2
      - {{ paths.config }}/monitoring/influxdb/config:/etc/influxdb2
    networks:
      - local

  loki:
    image: grafana/loki:latest
    container_name: loki
    restart: unless-stopped
    user: "{{ puid }}:{{ pgid }}"
    command: -config.file=/etc/loki/local-config.yaml
    ports:
      - "{{ service_ports.loki }}:3100"
    volumes:
      - {{ paths.config }}/monitoring/loki/data:/loki
      - {{ paths.config }}/monitoring/loki/config:/etc/loki:ro
    networks:
      - local

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    user: "{{ puid }}:{{ pgid }}"
    ports:
      - "{{ service_ports.grafana }}:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
    volumes:
      - {{ paths.config }}/monitoring/grafana/data:/var/lib/grafana
      - {{ paths.config }}/monitoring/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
    depends_on:
      - influxdb
      - loki
    networks:
      - local

networks:
  local:
    external: true
